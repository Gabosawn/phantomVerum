pragma language_version >= 0.23;

import CompactStandardLibrary;

// =====================================================================
// Testigo — OPTION B (spec docs/01-arquitectura.md §5): FROZEN FALLBACK
//
// WARNING: THIS CONTRACT IS NOT COMPILED NOR DEPLOYED BY DEFAULT.
//          The production contract is ../testigo.compact (Option A, Merkle).
//
// WHEN TO USE IT
//   Only as a safety net, if Option A breaks and there is no time to fix
//   it. Symptoms that justify it:
//     · the `credentialPath()` witness cannot be built off-chain
//       (e.g. `findPathForLeaf` does not return the expected shape);
//     · proving `report` with the Merkle tree does not close in
//       acceptable time for the live demo;
//     · a compiler regression breaks HistoricMerkleTree /
//       merkleTreePathRoot / checkRoot.
//
// HOW IT IS ACTIVATED (an artifact-path change, not a rewrite)
//   1. `compact compile src/fallback/testigo-b.compact output/`
//   2. In app/: point the contract import and the zk-config provider to
//      the same `output/`; drop the `issueCredential` calls and the
//      `credentialPath` witness (Option B has neither).
//   3. `registerOrganization(orgId, anchor)` now receives
//      `anchor = anchorOf(orgSecret)` — the exported pure circuit below.
//   4. The `credentialSecret()` witness now returns the SHARED
//      `orgSecret`, not the employee's individual secret.
//   `reportIdOf` and `authorshipOf` keep the exact signature and domain
//   tags of Option A, so `verify-authorship` off-chain does not change.
//   `nullifierOf` DIFFERS from Option A: here `period` is a free
//   Bytes<32> label with no blockTime binding — part of the weak
//   anti-spam declared below.
//
// MECHANISM
//   The organization publishes `anchor = H(dom || orgSecret)` and hands
//   the SAME `orgSecret` to all its employees (mock). The circuit checks
//   `H(orgSecret) == anchor`. Perfect anonymity within the org.
//
// DECLARED WEAKNESSES (spec §5, Option B — presented upfront as a limit
// of the mock issuer, not of the design):
//   · Weak anti-spam: whoever holds the orgSecret can mint N nullifiers
//     by using N distinct personal secrets.
//   · No revocation: once the orgSecret leaks, anyone reports as an
//     employee of that org and there is no way to cut it off.
//   · No access control on `registerOrganization` (same as in A).
// =====================================================================

// ---- Ledger state (spec §3) ----
export ledger organizations: Map<Bytes<32>, Bytes<32>>; // orgId -> anchor

export ledger reports: Set<Bytes<32>>; // sealed reportIds

export ledger nullifiers: Set<Bytes<32>>; // per-period anti-spam

export ledger authorships: Set<Bytes<32>>; // H(secret || reportId || prosecutorPk)

// ---- Witnesses (never leave the whistleblower's machine) ----
witness credentialSecret(): Bytes<32>; // orgSecret handed out by the org (mock)

witness personalSecret(): Bytes<32>; // the whistleblower's persistent secret

witness evidenceHash(): Bytes<32>; // hash of the file, computed locally

// ---- Domain separation (plan §2.2) ----
// `phantomtrace:anchor:v1` is Option B's own tag.
//
// ⚠️ This file is a FROZEN alternative, kept compiling as a fallback. It was
// written when its tags and arities matched Option A operand for operand; the
// contract v2 audit fixes moved Option A and this file deliberately did NOT
// follow, so the two are no longer digest-compatible:
//
//   · `reportIdOf`   — still identical.
//   · `nullifierOf`  — Option A dropped `orgId` (a caller-chosen public operand
//                      that made the anti-spam guard evadable) and is now
//                      Vector<3>; this one is still Vector<4>.
//   · `authorshipOf` — gone from Option A entirely, replaced by
//                      `receiptOf(reportId, prosecutorNonce)` under the tag
//                      `phantomtrace:receipt:v1`, which takes the personal
//                      secret out of the hash preimage.
//
// Do not reach for these as "the same" hashes. Option A's are in
// `../testigo.compact` and mirrored in `shared/src/crypto.ts`.
//
// 🔴 AND READ THIS BEFORE SWITCHING TO IT UNDER PRESSURE. Because this file
// did not follow the v2 fixes, it still CONTAINS the vulnerabilities that
// audit closed — it is not a safety net any more, it is a regression:
//
//   · `orgId` is back in the nullifier, and here `period` is not even
//     blockTime-bound: it is a free `Bytes<32>` label. Anti-spam is worth
//     nothing — the same credential buys unlimited reports by varying either.
//   · `authorshipOf` keeps `personalSecret` in the preimage, so verification
//     requires handing the secret to the prosecutor, who can then republish
//     the authorship or burn the slot (finding H-2).
//   · `registerOrganization` has no access control, same as Option A had.
//
// It is kept because it compiles and documents the design that was considered
// and rejected. Shipping it would undo the audit. If Option A ever genuinely
// breaks, port the v2 fixes here FIRST — the diff is small and the tests in
// `../test/sec-audit.mjs` and `receipt-authorship.mjs` say what to aim for.
circuit domAnchor(): Bytes<32> {
  return pad(32, "phantomtrace:anchor:v1");
}

circuit domReport(): Bytes<32> {
  return pad(32, "phantomtrace:report:v1");
}

circuit domNullifier(): Bytes<32> {
  return pad(32, "phantomtrace:nullifier:v1");
}

circuit domAuthorship(): Bytes<32> {
  return pad(32, "phantomtrace:authorship:v1");
}

export pure circuit anchorOf(orgSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([domAnchor(), orgSecret]);
}

export pure circuit reportIdOf(ev: Bytes<32>, sec: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([domReport(), ev, sec]);
}

export pure circuit nullifierOf(sec: Bytes<32>, orgId: Bytes<32>, period: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([domNullifier(), sec, orgId, period]);
}

export pure circuit authorshipOf(sec: Bytes<32>, reportId: Bytes<32>, prosecutorPk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([domAuthorship(), sec, reportId, prosecutorPk]);
}

// ---- 4.1 registerOrganization ----
export circuit registerOrganization(orgId: Bytes<32>, anchor: Bytes<32>): [] {
  assert(!organizations.member(disclose(orgId)), "organization already registered");
  organizations.insert(disclose(orgId), disclose(anchor));
}

// ---- 4.2 report ----
export circuit report(orgId: Bytes<32>, period: Bytes<32>): [] {
  const cred = credentialSecret();
  const sec = personalSecret();
  const ev = evidenceHash();

  // C1 — membership: H(orgSecret) == the org's anchor
  assert(organizations.member(disclose(orgId)), "organization not registered");
  assert(anchorOf(cred) == organizations.lookup(disclose(orgId)), "invalid credential");

  // C2 — per-period anti-spam (weak in this option: see header)
  const nul = nullifierOf(sec, orgId, period);
  assert(!nullifiers.member(disclose(nul)), "already reported this period");

  const id = reportIdOf(ev, sec);
  assert(!reports.member(disclose(id)), "report already sealed");

  reports.insert(disclose(id));
  nullifiers.insert(disclose(nul));
}

// ---- 4.3 revealAuthorship ----
export circuit revealAuthorship(reportId: Bytes<32>, prosecutorPk: Bytes<32>): [] {
  const sec = personalSecret();
  const ev = evidenceHash();

  // C1 — only the author knows the preimage (pure assert: no disclose)
  assert(reportIdOf(ev, sec) == reportId, "not the author");

  // C2 — the report exists
  assert(reports.member(disclose(reportId)), "report does not exist");

  const a = authorshipOf(sec, reportId, prosecutorPk);
  assert(!authorships.member(disclose(a)), "authorship already revealed to this prosecutor");
  authorships.insert(disclose(a));
}

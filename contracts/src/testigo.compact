pragma language_version >= 0.23;

import CompactStandardLibrary;

// =====================================================================
// Testigo — anonymous whistleblowing mailbox with deferred authorship
// Midnight Hack Buenos Aires 2026 · spec: docs/01-arquitectura.md §3–§5
//
// OPTION A (spec §5), "global tree" variant:
//   A single on-chain HistoricMerkleTree holds ALL issued credentials.
//   The organization is bound INSIDE the leaf:
//       leaf = H("…cred:v1" || orgId || H("…credcomm:v1" || credSecret))
//   The leaf is built IN-CIRCUIT from the public orgId at BOTH ends —
//   when issuing (`issueCredential`) and when proving (`report`) — so the
//   issuer cannot smuggle a leaf for an org that was never validated, and
//   the witness cannot lie about which org it belongs to: it only
//   provides the path siblings. Proving membership in the global tree
//   proves membership in THAT org — the spec's multi-org semantics hold.
//
//   Why HistoricMerkleTree and not MerkleTree: with the historic variant,
//   already-issued paths remain valid after new insertions, so issuing a
//   credential does not invalidate reports being prepared.
//
//   Why a global tree and not a per-org root in the Map: the generated TS
//   ledger exposes findPathForLeaf() over the tree ADT, which makes the
//   path witness ~5 lines of off-chain code. A per-org root would force a
//   hand-rolled Merkle tree in TypeScript.
//
// DECLARED LIMITATIONS (deck + README, spec §5 and §7):
//   · The credential issuer is a MOCK: `registerOrganization` and
//     `issueCredential` have NO access control — anyone can register an
//     org or add a leaf. That is the MVP scope, not an oversight: the
//     real issuer (a signing corporate directory) is roadmap.
//   · The TRUTH of the reported content is not proven (spec §6).
//   · There is no credential revocation (spec §7).
// =====================================================================

// ---- Ledger state (spec §3) ----

// orgId -> the organization's anchor. In Option A the anchor is issuer
// metadata (e.g. its public pk): membership is NOT verified against this
// value but against the credential tree. The Map acts as the registry of
// existing organizations (guard of `issueCredential`) and as the
// published anchor, exactly as spec §3 describes.
export ledger organizations: Map<Bytes<32>, Bytes<32>>;

// Global tree of issued credentials. Depth 8 = 256 leaves, enough for
// the demo (spec §5: "a small depth suffices").
export ledger credentials: HistoricMerkleTree<8, Bytes<32>>;

// Sealed reportIds: H(dom || evidenceHash || personalSecret)
export ledger reports: Set<Bytes<32>>;

// Per-epoch anti-spam: H(dom || credSecret || orgId || epoch).
// The epoch is fixed by the blockTime, not by the caller (see `report`).
export ledger nullifiers: Set<Bytes<32>>;

// Revealed authorships: H(dom || personalSecret || reportId || prosecutorPk)
export ledger authorships: Set<Bytes<32>>;

// ---- Witnesses: never leave the whistleblower's machine ----
// (the proof server runs LOCALLY — spec §1)

// Credential secret handed out by the organization (mock).
witness credentialSecret(): Bytes<32>;

// Merkle path siblings towards this credential's leaf.
// Obtained off-chain with `credentials.findPathForLeaf(leaf)`.
witness credentialPath(): Vector<8, MerkleTreePathEntry>;

// The whistleblower's persistent personal secret (org-independent).
witness personalSecret(): Bytes<32>;

// Hash of the evidence file, computed LOCALLY by the app.
// The file is never uploaded anywhere.
witness evidenceHash(): Bytes<32>;

// ---- Domain separation (spec/plan §2.2) ----
// `nullifier` and `authorship` share a shape and carry a secret in the
// same position: without a domain tag, an attacker who registers an org
// with orgId = reportId forces a cross collision between both hashes.
// `pad` requires literals, hence the tags live in helper circuits.

circuit domCred(): Bytes<32> {
  return pad(32, "phantomtrace:cred:v1");
}

circuit domCredComm(): Bytes<32> {
  return pad(32, "phantomtrace:credcomm:v1");
}

circuit domReport(): Bytes<32> {
  return pad(32, "phantomtrace:report:v1");
}

circuit domNullifier(): Bytes<32> {
  return pad(32, "phantomtrace:nullifier:v1");
}

circuit domAuthorship(): Bytes<32> {
  return pad(32, "phantomtrace:authorship:v1");
}

// ---- Reporting epochs ----
// Midnight's blockTime is `secondsSinceEpoch` (Unix seconds), so the
// duration is IN SECONDS. 86400 = 1 day. Deliberately coarse: fine
// periods allow timing correlation (spec §6).
circuit epochDuration(): Uint<64> {
  return 86400;
}

// ---- Exported pure circuits ----
// They appear in the generated TS under `pureCircuits`, so the app can
// recompute reportId / nullifier / authorship / leaf locally WITHOUT a
// proof server. This is what makes `verify-authorship` 100% off-chain.

// The credential commitment. It is the only thing the employee hands to
// the issuer: the org never sees the `credentialSecret`.
export pure circuit credCommitmentOf(credSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([domCredComm(), credSecret]);
}

// The leaf binds the credential TO ITS ORGANIZATION. It takes the
// COMMITMENT, not the secret, so `issueCredential` can rebuild it
// in-circuit from the orgId it just validated (see the note there).
export pure circuit leafOf(orgId: Bytes<32>, credCommitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([domCred(), orgId, credCommitment]);
}

// The report seal: only the author knows the preimage.
export pure circuit reportIdOf(ev: Bytes<32>, sec: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([domReport(), ev, sec]);
}

// Anti-spam: one report per (credential, org, epoch).
// `period` is the EPOCH INDEX (see `epochDuration`), not a free label:
// the `report` circuit forces it to be the current epoch.
export pure circuit nullifierOf(sec: Bytes<32>, orgId: Bytes<32>, period: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
           [domNullifier(), sec, orgId, (period as Field) as Bytes<32>]
           );
}

// Designated verifier: authorship is bound to THAT prosecutor's key.
export pure circuit authorshipOf(sec: Bytes<32>, reportId: Bytes<32>, prosecutorPk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([domAuthorship(), sec, reportId, prosecutorPk]);
}

// ---- 4.1 registerOrganization (spec §4.1) ----
// No witnesses. Idempotence: fails if the orgId already exists.
export circuit registerOrganization(orgId: Bytes<32>, anchor: Bytes<32>): [] {
  assert(!organizations.member(disclose(orgId)), "organization already registered");
  organizations.insert(disclose(orgId), disclose(anchor));
}

// ---- Option A helper: credential issuance (mock issuer) ----
// The issuer adds an employee's credential to the global tree. It
// receives the COMMITMENT (`credCommitmentOf(credSecret)`), not the
// secret: the org never sees the employee's secret.
//
// The leaf is built IN-CIRCUIT with the same orgId that was just
// validated against `organizations`. If the leaf arrived precomputed,
// the assert above would be decorative: one could pass a registered
// orgId and smuggle in the leaf of an organization that never
// registered, then report on behalf of that phantom org. Building it
// here ties insertion and validation to the SAME orgId.
export circuit issueCredential(orgId: Bytes<32>, credCommitment: Bytes<32>): [] {
  assert(organizations.member(disclose(orgId)), "organization not registered");
  credentials.insert(disclose(leafOf(orgId, credCommitment)));
}

// ---- 4.2 report — the heart (spec §4.2) ----
// Public: orgId, period (epoch index). Private: credential, path,
// secret, evidence.
export circuit report(orgId: Bytes<32>, period: Uint<64>): [] {
  const cred = credentialSecret();
  const siblings = credentialPath();
  const sec = personalSecret();
  const ev = evidenceHash();

  // C0 — the period is NOT freely chosen by the caller. If it were an
  // arbitrary label, the nullifier would be evadable: the same
  // credential yields N distinct nullifiers by varying the period, and
  // the anti-spam of spec §4.2/§6 is worth nothing. Here it is forced
  // to be the CURRENT epoch:
  //   start <= blockTime < start + duration   <=>   period == current epoch
  const windowStart = (period as Field) * (epochDuration() as Field);
  const windowEnd = windowStart + (epochDuration() as Field);
  assert(blockTimeGte(disclose(windowStart as Uint<64>)), "period not started yet");
  assert(blockTimeLt(disclose(windowEnd as Uint<64>)), "period already over");

  // C1 — membership. The leaf is built in-circuit from the public
  // orgId: the witness cannot substitute another org's leaf.
  const merklePath = MerkleTreePath<8, Bytes<32>> { leaf: leafOf(orgId, credCommitmentOf(cred)),
                                                    path: siblings };
  const root = merkleTreePathRoot<8, Bytes<32>>(merklePath);
  assert(credentials.checkRoot(disclose(root)), "credential does not belong to the organization");

  // C2 — per-period anti-spam. Uses the CREDENTIAL's secret (spec §5,
  // Option A): one credential = one report per period. Different
  // periods produce nullifiers that are not linkable to each other.
  const nullifier = nullifierOf(cred, orgId, period);
  assert(!nullifiers.member(disclose(nullifier)), "already reported this period");

  // The seal uses the PERSONAL secret: the one the whistleblower keeps
  // to prove authorship months later, whether the credential survives
  // or not.
  const id = reportIdOf(ev, sec);
  // Idempotence guard: Set.insert is idempotent; without this assert a
  // re-submission of the same report would pass silently.
  assert(!reports.member(disclose(id)), "report already sealed");

  reports.insert(disclose(id));
  nullifiers.insert(disclose(nullifier));
}

// ---- 4.3 revealAuthorship — the differentiator (spec §4.3) ----
// Public: reportId, prosecutorPk. Private: original evidence and secret.
export circuit revealAuthorship(reportId: Bytes<32>, prosecutorPk: Bytes<32>): [] {
  const sec = personalSecret();
  const ev = evidenceHash();

  // C1 — only the author knows the preimage of reportId.
  // Pure comparison over witness values: no disclose() required.
  assert(reportIdOf(ev, sec) == reportId, "not the author");

  // C2 — the report exists on the ledger.
  assert(reports.member(disclose(reportId)), "report does not exist");

  // Designated verifier: shown to another prosecutor (or the employer)
  // this record proves nothing — the hash is bound to prosecutorPk.
  const authorship = authorshipOf(sec, reportId, prosecutorPk);
  assert(!authorships.member(disclose(authorship)), "authorship already revealed to this prosecutor");
  authorships.insert(disclose(authorship));
}

// ---- 4.4 proveAuthorship — exportable ZK proof (spec §4.4) ----
// Public: reportId, evidenciaHash, prosecutorPk.
// Private: personalSecret (the same one used in `report`).
//
// NO ledger writes: this circuit exists to generate a portable ZK proof
// that the whitleblower gives to the verifier. The verifier checks the
// proof against the circuit's verifier key — the secret never leaves the
// whistleblower's machine.
//
// Returns `authorshipHash` so the verifier can cross-check it against
// `ledger.authorships` (which `revealAuthorship` wrote).
export circuit proveAuthorship(
  reportId: Bytes<32>,
  evidenciaHash: Bytes<32>,
  prosecutorPk: Bytes<32>,
): Bytes<32> {
  const sec = personalSecret();

  // The only assert: the secret must be the preimage of reportId.
  assert(reportIdOf(evidenciaHash, sec) == reportId, "not the author");

  // The authorship hash is disclosed so the verifier can confirm
  // it matches the one on-chain.
  return disclose(authorshipOf(sec, reportId, prosecutorPk));
}

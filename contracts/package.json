{
  "name": "@phantomtrace/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contratos Compact — Testigo (Midnight Hack BA 2026)",
  "scripts": {
    "compile": "compact compile src/testigo.compact output/",
    "compile:fast": "compact compile --skip-zk src/testigo.compact output/",
    "check:fallback": "compact compile --skip-zk src/fallback/testigo-b.compact output/fallback-check/",
    "format": "compact format src/testigo.compact src/fallback/testigo-b.compact",
    "test": "node test/smoke.mjs && node test/merkle-roundtrip.mjs && node test/security-claims.mjs && node test/sec-audit.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:e2e": "node test/merkle-roundtrip.mjs",
    "test:security": "node test/security-claims.mjs && node test/sec-audit.mjs",
    "clean": "rm -rf output/ zkir/"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  }
}

{
  "name": "@phantomtrace/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend React — Testigo (Midnight Hack BA 2026)",
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js --port 5174",
    "build": "if [ -n \"$(find src -name '*.ts' -o -name '*.tsx' -print -quit)\" ]; then node ../node_modules/typescript/lib/tsc.js && node ../node_modules/vite/bin/vite.js build; else echo '(ui) no .ts/.tsx under src yet — build skip'; fi",
    "preview": "node ../node_modules/vite/bin/vite.js preview --port 5174"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}

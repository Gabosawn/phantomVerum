{
  "name": "@phantomtrace/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phantom Trace — Cliente (local, privado) + Explorer (público) + Sistema visual",
  "scripts": {
    "dev": "npm run build:shared && node ../node_modules/concurrently/dist/bin/concurrently.js -n cliente,explorer,sistema -c magenta,cyan,gray \"npm:dev:cliente\" \"npm:dev:explorer\" \"npm:dev:sistema\"",
    "dev:cliente": "node ../node_modules/vite/bin/vite.js --config vite.cliente.config.ts",
    "dev:explorer": "node ../node_modules/vite/bin/vite.js --config vite.explorer.config.ts",
    "dev:sistema": "node ../node_modules/vite/bin/vite.js --config vite.sistema.config.ts",
    "build": "npm run build:shared && node ../node_modules/typescript/lib/tsc.js --noEmit && npm run build:cliente && npm run build:explorer && npm run build:sistema",
    "build:cliente": "node ../node_modules/vite/bin/vite.js build --config vite.cliente.config.ts",
    "build:explorer": "node ../node_modules/vite/bin/vite.js build --config vite.explorer.config.ts",
    "build:sistema": "node ../node_modules/vite/bin/vite.js build --config vite.sistema.config.ts",
    "build:shared": "npm run build --workspace=@phantomtrace/shared",
    "test": "npm run build:shared && node ../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "^8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "^4.1.1",
    "@phantomtrace/shared": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  }
}

{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@contracts/*": ["../contracts/output/*"]
    }
  },
  "include": ["cliente", "explorer", "sistema", "shared", "vite.base.ts", "vite.cliente.config.ts", "vite.explorer.config.ts", "vite.sistema.config.ts"]
}

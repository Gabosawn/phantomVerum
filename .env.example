# Testigo — variables de entorno (copiar a `.env`, que está gitignoreado)

# Seed del wallet que deploya/firma (64 chars hex = 32 bytes). NUNCA commitearla.
# Generar con:  openssl rand -hex 32
#   (o, cuando exista: npm run build --workspace=app && node app/dist/scripts/generar-seed.js)
# Después pedir tDUST para su address en el faucet de Preview.
DEPLOY_SEED=

# Red activa: preview | local
NETWORK=preview

# Proof server local (pinneado a midnightntwrk/proof-server:8.1.0, puerto 6300)
PROOF_SERVER=http://localhost:6300

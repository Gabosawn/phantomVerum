{
  "name": "@phantomtrace/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript wiring \u2014 witnesses, deploy, CLI scripts (Midnight Hack BA 2026)",
  "scripts": {
    "build": "npm run build --workspace=@phantomtrace/shared && node ../node_modules/typescript/lib/tsc.js -p .",
    "test": "npm run build && node dist/witnesses/selftest.js && node dist/witnesses/selftest-simulator.js && node dist/api/selftest-simulator.js",
    "deploy": "node dist/scripts/deploy.js",
    "register-org": "node dist/scripts/register-org.js",
    "issue-credential": "node dist/scripts/issue-credential.js",
    "report": "node dist/scripts/report.js",
    "reveal-authorship": "node dist/scripts/reveal-authorship.js",
    "verify-authorship": "node dist/scripts/verify-authorship.js",
    "e2e": "node dist/scripts/e2e.js"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.1.0",
    "@phantomtrace/shared": "0.1.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}

{
  "name": "phantomtrace",
  "version": "0.1.0",
  "private": true,
  "description": "Testigo — Denuncias de corrupción con anonimato reversible (Midnight Hack BA 2026)",
  "license": "Apache-2.0",
  "workspaces": [
    "contracts",
    "app",
    "ui",
    "tests"
  ],
  "scripts": {
    "compile": "npm run compile --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "simulate": "npm run simulate --workspace=tests",
    "postinstall": "node scripts/fix-noexec-bins.mjs",
    "clean": "rm -rf node_modules contracts/node_modules app/node_modules ui/node_modules tests/node_modules"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.62.4"
  }
}
